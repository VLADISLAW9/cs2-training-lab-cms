{
  "services": {
    "postgres": {
      "image": "postgres:16-alpine",
      "environment": {
        "POSTGRES_DB": "cs2_cms",
        "POSTGRES_USER": "cs2",
        "POSTGRES_PASSWORD": "cs2_local"
      },
      "ports": [
        "127.0.0.1:5434:5432"
      ],
      "volumes": [
        "postgres-data:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U cs2 -d cs2_cms"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      }
    }
  },
  "volumes": {
    "postgres-data": {}
  }
}
